# ---------------------------------------------------------------- build output
# `dmaic-harbor-build` writes one Harbor task directory per generated
# instance. They are reproducible from the builder plus a seed, so they are
# build output, not source. Never commit them: 419 English tasks are ~130 MB.
harbor/datasets/*/dmaic-*/
# `dataset.toml` sits BESIDE the task directories and is generated too -- build.py writes it,
# and `harbor add --scan` fills in the per-task digests at release time. A committed manifest
# would be stale the moment the corpus regenerates.
harbor/datasets/*/dataset.toml
harbor/jobs/
build/
dist/
*.egg-info/
*.whl
*.tar.gz

# ---------------------------------------------------------------- run output
jobs/
trials/
runs/
*.jsonl.tmp

# ---------------------------------------------------------------- caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/

# ---------------------------------------------------------------- credentials
# No key, token, or endpoint list may ever enter this repository. The campaign
# runner reads them from a file kept OUTSIDE the working tree, chmod 600.
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
campaign.env
*.local.yaml
*.local.yml
*.local.json

# ---------------------------------------------------------------- held out
# The nine expert-derived cases and their identity assets are not part of the
# public release. See docs/HELD_OUT.md.
dmaic_bench/cases/_identity_map.json
dmaic_bench/cases/legacy_bridge.py

# ---------------------------------------------------------------- OS
.DS_Store
paper/iclr/*.pdf
paper/iclr/*.log
paper/iclr/*.blg
paper/iclr/*.aux
paper/iclr/*.bbl
paper/iclr/*.xdv
# author identity: camera-ready only
paper/authors.yaml
paper/iclr/authors.tex
paper/openreview_note.json

# ---------------------------------------------------------------- held literature
# Licensed standards and subscription articles kept for citation checks; never redistribute.
sources/literature/*.pdf
sources/literature/txt/
