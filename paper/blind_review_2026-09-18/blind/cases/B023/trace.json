{
  "steps": [
    {
      "step_id": 1,
      "method_id": "quality.pareto",
      "inputs_digest": {
        "batch": "candidates",
        "nCategories": 5,
        "totalRejects": 240
      },
      "outputs": {
        "topCategoryPct": 26.666666666666668
      },
      "status": "success",
      "decision": "Largest reject category is \"loose end\" at 26.7% of 240 rejects. No single category dominates, so a Pareto-led attack on one category is not justified."
    },
    {
      "step_id": 2,
      "method_id": "quality.fmea_rpn",
      "inputs_digest": {
        "batch": "failure_modes",
        "nModes": 5
      },
      "outputs": {
        "maxRpn": 504
      },
      "status": "success",
      "decision": "Highest risk mode is \"stain\" at RPN 504, driven by a detection rating of 8 - i.e. the top risk is that the defect is not reliably caught by inspection, pointing at the measurement system."
    },
    {
      "step_id": 3,
      "method_id": "msa.attribute_agreement",
      "inputs_digest": {
        "batch": "agreement",
        "nParts": 20,
        "nAppraisers": 3,
        "nTrials": 2,
        "standardKnown": true
      },
      "outputs": {
        "kappaMin": 0.3478260869565216,
        "agreementPct": 30.0,
        "allVsStandardPct": 30.0,
        "withinAppraiser1Pct": 85.0,
        "withinAppraiser2Pct": 70.0,
        "withinAppraiser3Pct": 55.0,
        "appraiser1VsStandardPct": 70.0,
        "appraiser2VsStandardPct": 55.0,
        "appraiser3VsStandardPct": 50.0,
        "msaAcceptable": false
      },
      "status": "success",
      "decision": "FAIL. Worst Cohen kappa vs the answer key is 0.348, far below the 0.75 acceptability floor; all three appraisers agree with each other on only 30% of units and repeatability is as low as 55%. The pass/fail judgement cannot be relied on, so every downstream defective rate in this project inherits that doubt."
    },
    {
      "step_id": 4,
      "method_id": "control_chart.p",
      "inputs_digest": {
        "batch": "lots",
        "nSubgroups": 25,
        "subgroupSize": 5000,
        "totalInspected": 125000.0
      },
      "outputs": {
        "centerLine": 0.001016,
        "outOfControlCount": 0,
        "centerLineDpmo": 1016.0,
        "uclCounts": 11.838220807283525,
        "maxLotDpmo": 2200.0,
        "minLotDpmo": 400.0
      },
      "status": "success",
      "decision": "Stable. 0 of 25 lots outside the limits, so the defective share has held steady across the twenty-five lots at a centre line of 1016 DPMO. Lot-to-lot variation is common cause."
    },
    {
      "step_id": 5,
      "method_id": "capability.binomial",
      "inputs_digest": {
        "batch": "lots",
        "totalInspected": 125000.0,
        "totalDefective": 127.0
      },
      "outputs": {
        "avgP": 0.001016,
        "processZ": 3.085514962525518,
        "avgPDpmo": 1016.0
      },
      "status": "success",
      "decision": "Baseline capability: average defective share 1016 DPMO, process Z = 3.09."
    },
    {
      "step_id": 6,
      "method_id": "basic.one_proportion",
      "inputs_digest": {
        "batch": "lots",
        "defective": 127.0,
        "inspected": 125000.0,
        "requirementDpmo": 1500,
