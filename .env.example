# DMAIC-Bench — contestant credentials. NAMES ONLY; this file carries no secret.
#
# DO NOT fill this in and leave it in the repository. Copy it to the durable location the
# loader reads and fill it in THERE:
#
#     mkdir -p ~/.config/dmaic && chmod 700 ~/.config/dmaic
#     cp .env.example ~/.config/dmaic/campaign.env
#     chmod 600 ~/.config/dmaic/campaign.env
#     $EDITOR ~/.config/dmaic/campaign.env
#
# WHY OUTSIDE THE REPOSITORY, and not merely gitignored. `.gitignore` stops `git add`. It does
# not stop `git add -f`, `git stash -u`, an editor or CI step that archives the working tree, or
# a Docker build whose context is the working tree -- and this project's images ARE built from
# it. A file that never enters the tree cannot leave through any of those.
#
# Every value below is a bearer credential: anything that can read it can spend money as you.

# --- OpenAI-compatible gateway
export OPENAI_API_BASE=""
export OPENAI_BASE_URL=""
export OPENAI_API_KEY=""

# --- Anthropic-wire gateway
export ANTHROPIC_GW_BASE=""
export ANTHROPIC_GW_KEY=""

# --- Google / Gemini gateway
export GEMINI_GW_BASE=""
export GEMINI_GW_KEY=""

# --- Moonshot
export MOONSHOT_API_BASE=""
export MOONSHOT_API_KEY=""

# --- Zhipu / ChatGLM (open.bigmodel.cn). OpenAI-compatible.
export ZHIPU_API_BASE=""
export ZHIPU_API_KEY=""

# --- Z.AI (the international Zhipu platform, billed SEPARATELY from open.bigmodel.cn --
#     credit on one says nothing about the other). Anthropic-wire: route as anthropic/glm-*.
export ZAI_BASE=""
export ZAI_KEY=""
